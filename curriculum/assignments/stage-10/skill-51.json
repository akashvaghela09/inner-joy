    ],
    "title": "A rule on values",
    "prompt": "Create a table named plans with id INTEGER PRIMARY KEY and code TEXT, where a CHECK uses GLOB so codes must start with a capital letter. Then add a valid row, id 1 with code GOLD, and use INSERT OR IGNORE for an invalid one, id 2 with code gold. Only the valid row should stay.",
    "dataset": "app",
    "hints": [
      "INSERT OR IGNORE skips a row that breaks a rule."
    ],
    "check": {
      "mode": "table",
      "sql": "SELECT p.id, p.code, (SELECT COUNT(*) FROM users) AS users FROM plans p ORDER BY p.id;",
      "ordered": true,
      "columnNames": true
    },
    "cases": [
      {
        "name": "App Activity",
        "hidden": false,
        "expected": {
          "columns": [
            "id",
            "code",
            "users"
          ],
          "rows": [
            [
              1,
              "GOLD",
              5
            ]
          ]
        }
      },
      {
        "name": "Different data",
        "hidden": true,
        "setupSql": "DELETE FROM sessions; DELETE FROM users; INSERT INTO users VALUES (7, 'sable', NULL, '2024-02-27'), (8, 'tulip', 7, '2024-02-28'), (9, 'umber', 7, '2024-03-01'); INSERT INTO sessions VALUES (11, 7, '2024-02-28', 50, 'web'), (12, 7, '2024-02-29', 50, 'web'), (13, 7, '2024-03-01', 7, 'ios'), (14, 8, '2024-03-02', 33, 'android');",
        "expected": {
          "columns": [
            "id",
            "code",
            "users"
          ],
          "rows": [
            [
              1,
              "GOLD",
              3
            ]
          ]
        }
      }
    ],
    "solutions": [
      "CREATE TABLE plans (id INTEGER PRIMARY KEY, code TEXT CHECK (code GLOB '[A-Z]*')); INSERT INTO plans VALUES (1, 'GOLD'); INSERT OR IGNORE INTO plans VALUES (2, 'gold');"
    ],
    "wrongSolutions": [
      {
        "sql": "CREATE TABLE plans (id INTEGER PRIMARY KEY, code TEXT); INSERT INTO plans VALUES (1, 'GOLD'); INSERT OR IGNORE INTO plans VALUES (2, 'gold');",
        "why": "No rule, so the bad row stays"
      },
      {
        "sql": "CREATE TABLE plans (id INTEGER PRIMARY KEY, code TEXT CHECK (code GLOB '[A-Z]*')); INSERT OR IGNORE INTO plans VALUES (2, 'gold');",
        "why": "Leaves out the valid row"
      }
    ]
  },
