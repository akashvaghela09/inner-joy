    "title": "Create an index",
    "prompt": "Create an index named idx_orders_customer on orders (customer_id). Replace the ___.",
    "dataset": "shop",
    "starterSql": "CREATE INDEX idx_orders_customer\nON orders (___);",
    "hints": [
      "CREATE INDEX name ON table (column)."
    ],
    "check": {
      "mode": "table",
      "sql": "SELECT i.name, c.name AS column_name FROM pragma_index_list('orders') i, pragma_index_info(i.name) c ORDER BY i.name;",
      "ordered": true,
      "columnNames": true
    },
    "cases": [
      {
        "name": "Online Shop",
        "hidden": false,
        "expected": {
          "columns": [
            "name",
            "column_name"
          ],
          "rows": [
            [
              "idx_orders_customer",
              "customer_id"
            ]
          ]
        }
      },
      {
        "name": "Different data",
        "hidden": true,
        "setupSql": "INSERT INTO customers VALUES (50, 'x', 'y', NULL, '2024-01-01');",
        "expected": {
          "columns": [
            "name",
            "column_name"
          ],
          "rows": [
            [
              "idx_orders_customer",
              "customer_id"
            ]
          ]
        }
      }
    ],
    "solutions": [
      "CREATE INDEX idx_orders_customer ON orders (customer_id);"
    ],
    "wrongSolutions": [
      {
        "sql": "CREATE INDEX idx_orders_customer ON orders (status);",
        "why": "Uses the wrong column"
      },
      {
        "sql": "CREATE INDEX idx_orders ON orders (customer_id);",
        "why": "Uses the wrong name"
      }
    ]
