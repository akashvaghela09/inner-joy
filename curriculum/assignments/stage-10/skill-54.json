    "title": "Read a plan",
    "prompt": "Finding orders by customer_id currently scans the whole table. Create an index named idx_c that lets that query use SEARCH instead. You can check with EXPLAIN QUERY PLAN.",
    "dataset": "shop",
    "hints": [
      "Index the column the query filters on."
    ],
    "check": {
      "mode": "table",
      "sql": "SELECT detail FROM (SELECT 1 AS x) JOIN pragma_index_list('orders') ON 1 = 1 JOIN (SELECT 'uses index' AS detail) ON 1 = 1 WHERE name = 'idx_c' AND EXISTS (SELECT 1 FROM pragma_index_info('idx_c') WHERE name = 'customer_id');",
      "ordered": true,
      "columnNames": true
    },
    "cases": [
      {
        "name": "Online Shop",
        "hidden": false,
        "expected": {
          "columns": [
            "detail"
          ],
          "rows": [
            [
              "uses index"
            ]
          ]
        }
      },
      {
        "name": "Different data",
        "hidden": true,
        "setupSql": "INSERT INTO customers VALUES (50, 'x', 'y', NULL, '2024-01-01');",
        "expected": {
          "columns": [
            "detail"
          ],
          "rows": [
            [
              "uses index"
            ]
          ]
        }
      }
    ],
    "solutions": [
      "CREATE INDEX idx_c ON orders (customer_id);"
    ],
    "wrongSolutions": [
      {
        "sql": "CREATE INDEX idx_c ON orders (status);",
        "why": "A status index won't help"
      },
      {
        "sql": "SELECT * FROM orders WHERE customer_id = 1;",
        "why": "Doesn't create an index"
      }
    ]
