          ]
        }
      },
      {
        "name": "Different data",
        "hidden": true,
        "setupSql": "DELETE FROM order_items; DELETE FROM orders; DELETE FROM products; DELETE FROM customers; INSERT INTO customers VALUES (7, 'Ravi', 'Oslo', 'ravi@mail.test', '2024-05-05'), (8, 'Sara', 'Lima', NULL, '2024-06-06'), (9, 'Tom', 'Oslo', NULL, '2024-07-07'); INSERT INTO products VALUES (7, 'Stool', 'Home', 40.0, 25.0), (8, 'Cup', 'Kitchen', 9.0, 2.0), (9, 'Ink', 'Stationery', 12.5, 6.0); INSERT INTO orders VALUES (11, 7, '2024-02-28', 'shipped'), (12, 8, '2024-03-01', 'pending'), (13, 7, '2024-03-31', 'cancelled'); INSERT INTO order_items VALUES (11, 7, 1, 4.0), (11, 8, 3, NULL), (12, 9, 2, NULL), (13, 8, 1, NULL);",
        "expected": {
          "columns": [
            "city"
          ],
          "rows": [
            [
              "Oslo"
            ],
            [
              "Lima"
            ]
          ]
        }
      }
    ],
    "solutions": [
      "SELECT DISTINCT city FROM customers;"
    ],
    "wrongSolutions": [
      {
        "sql": "SELECT city FROM customers;",
        "why": "Keeps duplicates"
      },
      {
        "sql": "SELECT DISTINCT name FROM customers;",
        "why": "Uses the wrong column"
      }
    ]
  },
